# ---------------------------------------------------------------------------
# CONFIGURATION KOBOTOOLBOX
# Copiez ce fichier en ".env" puis renseignez vos valeurs.
# Le fichier .env est ignoré par Git : vos identifiants restent privés.
# ---------------------------------------------------------------------------

# Instance KoboToolbox utilisee
KOBO_API_URL=https://kf.kobotoolbox.org

# Jeton d'API : KoboToolbox > Account > Settings > API token
KOBO_TOKEN=COLLEZ_VOTRE_JETON_ICI

# Identifiant (UID) du formulaire deploye : URL
# https://kf.kobotoolbox.org/#/forms/<UID>
KOBO_ASSET_UID=COLLEZ_L_UID_DU_FORMULAIRE_ICI

# ---------------------------------------------------------------------------
# EN-TETES DU RAPPORT (facultatif)
# ---------------------------------------------------------------------------
# MINISTERE=MINISTÈRE DE L'ÉDUCATION NATIONALE
# INSPECTION=INSPECTION D'ACADÉMIE DE KAOLACK
# IEF=INSPECTION DE L'ÉDUCATION ET DE LA FORMATION DE NIORO DU RIP
# ANNEE_SCOLAIRE=2025/2026

# Minutes au-dela desquelles une soumission est consideree trop ancienne
# MAX_AGE_MINUTES=30
